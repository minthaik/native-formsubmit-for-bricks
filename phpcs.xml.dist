<?xml version="1.0"?>
<ruleset name="Native FormSubmit for Bricks">
  <description>WordPress coding, security and PHP compatibility checks.</description>
  <file>native-formsubmit-for-bricks.php</file>
  <file>includes</file>
  <file>uninstall.php</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="native-formsubmit-for-bricks"/></property></properties></rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals"><properties><property name="prefixes" type="array"><element value="fsbr"/><element value="formsubmit_for_bricks"/><element value="FormSubmitForBricks"/></property></properties></rule>
  <config name="testVersion" value="7.4-"/>
  <rule ref="PHPCompatibilityWP"/>
</ruleset>
